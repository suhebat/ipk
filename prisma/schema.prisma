}

model data_pengajuan_provinsi {
  pengajuan_id   BigInt         @id
  skor_ipk       Decimal        @db.Decimal(5, 2)
  skor_dimensi   String         @db.LongText
  data_pengajuan data_pengajuan @relation(fields: [pengajuan_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_dpp")

model data_pengajuan {
  id                      BigInt                   @id @default(autoincrement())
  jenis                   data_pengajuan_jenis
  tahun                   Int
  kode_provinsi           String?                  @db.VarChar(5)
  status                  data_pengajuan_status    @default(draft)
  catatan_verifikator     String?                  @db.Text
  dibuat_oleh             Int?
  diverifikasi_oleh       Int?
  dipublish_oleh          Int?
  created_at              DateTime                 @default(now()) @db.Timestamp(0)
  updated_at              DateTime                 @default(now()) @db.Timestamp(0)
  submitted_at            DateTime?                @db.Timestamp(0)
  approved_at             DateTime?                @db.Timestamp(0)
  published_at            DateTime?                @db.Timestamp(0)
  rejected_at             DateTime?                @db.Timestamp(0)
  data_pengajuan_log      data_pengajuan_log[]
  data_pengajuan_nasional data_pengajuan_nasional?
  data_pengajuan_provinsi data_pengajuan_provinsi?

  @@index([kode_provinsi, tahun], map: "idx_prov_tahun")

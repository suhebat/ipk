model permissions {
  id               Int                @id @default(autoincrement())
  kode             String             @unique(map: "kode") @db.VarChar(60)
  nama             String             @db.VarChar(100)
  grup             String             @db.VarChar(40)
  deskripsi        String?            @db.VarChar(255)
  role_permissions role_permissions[]
}

model role_permissions {
  role_id       Int
  permission_id Int
  permissions   permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_rp_perm")
  roles         roles       @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_rp_role")

  @@id([role_id, permission_id])
  @@index([permission_id], map: "fk_rp_perm")
}

model roles {
  id               Int                @id @default(autoincrement())
  kode             String             @unique(map: "kode") @db.VarChar(40)
  nama             String             @db.VarChar(80)
  deskripsi        String?            @db.VarChar(255)
  urutan           Int                @default(0)
  created_at       DateTime           @default(now()) @db.Timestamp(0)
  admin_roles      admin_roles[]
  role_permissions role_permissions[]
}

enum admins_status {

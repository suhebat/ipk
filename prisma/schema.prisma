/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model surat_masuk {
  id               BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  nomor_tiket      String?              @unique(map: "uq_surat_nomor_tiket") @db.VarChar(50)
  nomor_agenda     String?              @db.VarChar(50)
  nomor_surat      String?              @db.VarChar(150)
  tanggal_surat    DateTime?            @db.Date
  tanggal_diterima DateTime             @db.Date
  nama_pengirim    String               @db.VarChar(150)
  email_pengirim   String               @db.VarChar(150)
  telepon_pengirim String?              @db.VarChar(50)
  asal_instansi    String?              @db.VarChar(200)
  kategori         surat_masuk_kategori @default(lainnya)
  perihal          String               @db.VarChar(255)
  ringkasan        String               @db.Text
  file_surat       String?              @db.VarChar(255)
  status           surat_masuk_status   @default(baru)
  disposisi_kepada String?              @db.VarChar(200)
  catatan          String?              @db.Text
  created_at       DateTime             @default(now()) @db.DateTime(0)
  updated_at       DateTime             @default(now()) @db.DateTime(0)

  @@index([email_pengirim], map: "idx_surat_email")
  @@index([nomor_agenda], map: "idx_surat_nomor_agenda")
  @@index([status], map: "idx_surat_status")
  @@index([tanggal_diterima], map: "idx_surat_tanggal")
}


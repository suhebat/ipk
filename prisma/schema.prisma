generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model admins {
  id             Int             @id @default(autoincrement())
  nama           String?         @db.VarChar(100)
  username       String          @unique(map: "username") @db.VarChar(50)
  password       String          @db.VarChar(255)
  role           admins_role     @default(admin)
  status         admins_status   @default(aktif)
  remember_token String          @db.VarChar(255)
  foto           String          @db.VarChar(255)
  email          String          @db.VarChar(150)
  admin_roles    admin_roles[]
  log_aktivitas  log_aktivitas[]
}

model dimension_methodologies {
  id                   Int        @id @default(autoincrement())
  dimension_id         Int
  year_start           Int        @db.Year
  year_end             Int?       @db.Year
  definisi_operasional String     @db.Text
  dimensions           dimensions @relation(fields: [dimension_id], references: [id], onDelete: Cascade, map: "fk_dimension_methodologies_dimension")

  @@index([dimension_id], map: "idx_dimension_id")
}

model dimensions {
  id                      Int                       @id @default(autoincrement())
  slug                    String                    @unique(map: "slug") @db.VarChar(50)
  name                    String                    @db.VarChar(100)
  dimension_methodologies dimension_methodologies[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model download_survey {
  id               Int      @id @default(autoincrement()) @db.UnsignedInt
  nama             String   @db.VarChar(150)
  email            String   @db.VarChar(150)
  bidang_pekerjaan String   @db.VarChar(100)
  tujuan_unduh     String   @db.VarChar(255)
  jenis_unduh      String   @db.VarChar(20)
  halaman          String   @db.VarChar(40)
  tahun            Int?
  provinsi         String?  @db.VarChar(100)
  ip_address       String?  @db.VarChar(45)
  user_agent       String?  @db.VarChar(255)
  created_at       DateTime @default(now()) @db.Timestamp(0)

  @@index([created_at], map: "idx_created")
  @@index([halaman], map: "idx_halaman")
  @@index([jenis_unduh], map: "idx_jenis")
}

model ipk_nasional_tahunan {
  tahun     Int      @id @db.Year
  dimensi_1 Decimal? @db.Decimal(5, 2)
  dimensi_2 Decimal? @db.Decimal(5, 2)
  dimensi_3 Decimal? @db.Decimal(5, 2)
  dimensi_4 Decimal? @db.Decimal(5, 2)
  dimensi_5 Decimal? @db.Decimal(5, 2)
  dimensi_6 Decimal? @db.Decimal(5, 2)
  dimensi_7 Decimal? @db.Decimal(5, 2)
  skor_ipk  Decimal? @db.Decimal(5, 2)
}

model log_aktivitas {
  id         Int      @id @default(autoincrement())
  admin_id   Int
  aktivitas  String   @db.VarChar(255)
  nama_file  String?  @db.VarChar(255)
  kategori   String?  @default("Upload") @db.VarChar(100)
  created_at DateTime @default(now()) @db.Timestamp(0)
  admins     admins   @relation(fields: [admin_id], references: [id], onDelete: Cascade, map: "fk_log_admins")

  @@index([admin_id], map: "fk_log_admins")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model metadata_indikator {
  id                  Int                                    @id @default(autoincrement()) @db.UnsignedInt
  kode_indikator      String?                                @db.VarChar(50)
  tahun               Int                                    @default(2024)
  dimensi             String                                 @db.VarChar(100)
  nama_indikator      String                                 @db.VarChar(255)
  slug                String?                                @unique(map: "slug") @db.VarChar(255)
  konsep_definisi     String                                 @db.Text
  interpretasi        String                                 @db.Text
  contoh_interpretasi String?                                @db.Text
  rumus_perhitungan   String?                                @db.Text
  rumus_pembilang     String?                                @db.Text
  rumus_penyebut      String?                                @db.Text
  variabel_pembangun  String?                                @db.Text
  kegiatan_penghasil  String                                 @db.VarChar(255)
  ukuran_satuan       String?                                @default("Persen") @db.VarChar(50)
  waktu_ketersediaan  String?                                @default("Tahunan") @db.VarChar(50)
  level_estimasi      String?                                @default("Nasional, provinsi") @db.VarChar(100)
  dapat_diakses_umum  metadata_indikator_dapat_diakses_umum? @default(Ya)
  publikasi_terkait   String?                                @default("Website IPK dan eBook IPK") @db.VarChar(255)
  urutan              Int?                                   @default(0)
  is_active           Boolean?                               @default(true)
  created_at          DateTime                               @default(now()) @db.Timestamp(0)
  updated_at          DateTime                               @default(now()) @db.Timestamp(0)

  @@index([dimensi], map: "idx_dimensi")
  @@index([kegiatan_penghasil], map: "idx_kegiatan")
  @@index([tahun], map: "idx_tahun")
  @@fulltext([nama_indikator, konsep_definisi, interpretasi], map: "idx_search")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model permohonan_data {
  id                 BigInt                        @id @default(autoincrement()) @db.UnsignedBigInt
  nomor_permohonan   String                        @unique(map: "uq_permohonan_nomor") @db.VarChar(50)
  tanggal_permohonan DateTime                      @db.Date
  nama_pemohon       String                        @db.VarChar(150)
  email              String                        @db.VarChar(150)
  telepon            String                        @db.VarChar(50)
  instansi           String                        @db.VarChar(200)
  jabatan            String?                       @db.VarChar(100)
  jenis_pemohon      permohonan_data_jenis_pemohon
  jenis_data         String                        @db.VarChar(100)
  wilayah            permohonan_data_wilayah
  detail_wilayah     String?                       @db.Text
  format_data        permohonan_data_format_data
  tahun_data         String                        @db.VarChar(100)
  tujuan             String                        @db.VarChar(100)
  detail_permintaan  String                        @db.Text
  referensi          String?                       @db.VarChar(255)
  lampiran           String?                       @db.VarChar(255)
  status             permohonan_data_status        @default(baru)
  catatan_admin      String?                       @db.Text
  diproses_pada      DateTime?                     @db.DateTime(0)
  selesai_pada       DateTime?                     @db.DateTime(0)
  created_at         DateTime                      @default(now()) @db.DateTime(0)
  updated_at         DateTime                      @default(now()) @db.DateTime(0)

  @@index([email], map: "idx_permohonan_email")
  @@index([status], map: "idx_permohonan_status")
  @@index([tanggal_permohonan], map: "idx_permohonan_tanggal")
}

